{
  "name": "ai-agent-trajectory-evaluator",
  "version": "1.0.0",
  "description": "Deterministic static analysis and forensic audit harness for autonomous AI coding agent trajectories (SWE-bench, Claude Code, Devin, Outlier, Mercor).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agent-eval": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts --demo",
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "tsx --test src/__tests__/*.test.ts"
  },
  "keywords": [
    "ai-agent",
    "swe-bench",
    "trajectory-evaluation",
    "llm-evaluation",
    "code-forensics",
    "owasp-llm",
    "agentic-ai",
    "mercor",
    "outlier-ai",
    "rlhf"
  ],
  "author": "Pritesh Loke <https://github.com/priteshloke>",
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
